# Admin bootstrap user. Used only if the admin account does not exist yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# JWT signing secret for the HttpOnly session cookie.
# Use at least 32 random characters.
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars

# Portal connection. With the included Mosquitto, use these internal values.
# Compose supplies MQTT_BROKER_PASSWORD_FILE through a generated Docker secret.
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_BROKER_USERNAME=dp-backend
# For an external broker, use mqtts://broker.example.org:8883 and its credentials.
# MQTT_BROKER_PASSWORD=your-external-broker-password
# MQTT_BROKER_PASSWORD_FILE=/run/secrets/your-broker-password
# Optional client TLS files, readable inside the API container. Server verification is always enabled.
# MQTT_BROKER_CA_FILE=/certs/private-ca.pem
# MQTT_BROKER_CLIENT_CERT_FILE=/certs/client.pem
# MQTT_BROKER_CLIENT_KEY_FILE=/certs/client-key.pem

# Public values are returned by GET /device/mqtt-configuration.
MQTT_PUBLIC_HOST=mqtt.example.org
# Optional overrides; the standard Nginx deployment needs neither.
# MQTT_PUBLIC_PORT=8883
# MQTT_PROXY_PORT=1883
# Only used with docker-compose.mosquitto-tls.yml for TLS directly on Mosquitto.
# Contains readable fullchain.pem and privkey.pem; no dangling symlinks.
# MQTT_TLS_DIR=./certs/mqtt

# Key used to encrypt sensitive device string properties.
# Accepted formats:
# - 64 hex chars
# - base64 for 32 raw bytes
DEVICE_PROPERTIES_ENCRYPTION_KEY=replace-with-64-random-hex-characters

# Comma-separated allowlist for browser origins allowed to call backend APIs
# Example: http://localhost:5173,https://dashboard.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://deviceportal.example.org

# SQLite path for local execution, relative to the backend working directory.
# Docker Compose sets the container path separately.
DB_PATH=./data.db

# Host directory mounted into the API container
DB_PATH_HOST=./data

# Optional API request logging
ENABLE_REQUEST_LOGS=false
